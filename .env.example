# ==========================================
# LegalLens Environment Configuration Example
# Copy this file to .env and fill in values.
# DO NOT commit .env to version control!
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=LegalLens
API_V1_PREFIX=/api

# Security / JWT
SECRET_KEY=change_this_to_a_random_secure_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL via SQLAlchemy psycopg2 driver)
# Default format: postgresql://user:password@localhost:5432/legallens
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legallens

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR=./backend/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Classification Model
MODEL_PATH=law-ai/InLegalBERT
USE_MOCK_CLASSIFIER=False

# External LLM API for Grounded RAG Q&A (Server-side only)
# Choose either 'anthropic' or 'openai'
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4o-mini
